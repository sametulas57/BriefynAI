@page
@model MeetingWeb.Pages.AskModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Arşive sor";
    var hasTurn = Model.Result != null || Model.ScopeMessage != null;
    // Answered questions move into the conversation; the rest stay in the box to be corrected.
    var draft = hasTurn && Model.Result?.Status == MeetingWeb.Services.ArchiveSearch.AskStatus.Answered ? "" : Model.Question ?? "";
}
<svg class="absolute size-0" aria-hidden="true" focusable="false">
    <defs>
        <linearGradient id="ask-mark-ink" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="88" y2="0">
            <stop offset="0" stop-color="#00D3E6" />
            <stop offset="1" stop-color="#1E9BFF" />
        </linearGradient>
    </defs>
</svg>

<div class="ask" data-ask data-state="@(hasTurn ? "chat" : "empty")">
    @* The home page's meeting room at night; it fades out once the conversation starts. *@
    <div class="ask-photo" aria-hidden="true">
        <picture>
            <source media="(max-width: 860px)" srcset="/img/home/salon-gece-dikey-780.webp" width="780" height="1386" />
            <img src="/img/home/salon-gece-genis-1440.webp" width="1600" height="900" alt="" decoding="async" />
        </picture>
    </div>

    <div class="ask-intro">
        <h1 class="ask-title">Hangi konuyu hatırlatayım?</h1>
        <p class="ask-lede">Cevabı yalnız sizin toplantılarınızdan veririm ve nereden aldığımı gösteririm.</p>
    </div>

    <section class="ask-thread" data-ask-thread aria-label="Sohbet">
        @if (hasTurn)
        {
            <article class="ask-turn">
                <div class="ask-question">
                    <h2 class="sr-only">Sorunuz</h2>
                    <p class="ask-bubble">@Model.Question</p>
                    @if (Model.IsNarrowed)
                    {
                        <p class="ask-asked-in">@Model.ScopeLabel()</p>
                    }
                </div>
                <div class="ask-reply">
                    <partial name="_BriefynMark" />
                    <div class="ask-reply-body"><h2 class="sr-only">Briefyn'in cevabı</h2><partial name="_AskAnswer" model="Model" /></div>
                </div>
            </article>
        }
    </section>

    <div class="ask-dock">
        <form method="post" id="ask-form" class="ask-composer" data-ask-form>
            <label asp-for="Question" class="sr-only">Sorunuz</label>
            <textarea name="Question" id="Question" class="ask-input" rows="1" maxlength="500" placeholder="Bir şey sorun" data-ask-input>
@draft</textarea>
            <div class="ask-bar">
                <details class="ask-scope" data-ask-scope>
                    <summary>@await Html.PartialAsync("_Icons", "filter")<span class="sr-only">Nerede aransın: </span><span class="ask-scope-label" data-ask-scope-label>@Model.ScopeLabel()</span></summary>
                    <div class="ask-scope-panel">
                        <fieldset class="ask-field">
                            <legend>Nerede aransın</legend>
                            <div class="ask-choices">
                                <label><input type="radio" name="Scope" value="Archive" checked="@(Model.Scope is not ("Series" or "Meeting"))" /><span>Tüm arşiv</span></label>
                                <label><input type="radio" name="Scope" value="Series" checked="@(Model.Scope == "Series")" /><span>Bir seri</span></label>
                                <label><input type="radio" name="Scope" value="Meeting" checked="@(Model.Scope == "Meeting")" /><span>Bir toplantı</span></label>
                            </div>
                        </fieldset>
                        <div class="ask-field" data-ask-target="Series">
                            <label asp-for="SeriesId">Seri</label>
                            <select asp-for="SeriesId" class="ask-control">
                                <option value="">Seri seçin</option>
                                @foreach (var series in Model.Series)
                                {
                                    <option value="@series.Id" data-label="@series.Name">@series.Name</option>
                                }
                            </select>
                        </div>
                        <div class="ask-field" data-ask-target="Meeting">
                            <label asp-for="MeetingId">Toplantı</label>
                            <select asp-for="MeetingId" class="ask-control">
                                <option value="">Toplantı seçin</option>
                                @foreach (var meeting in Model.Meetings)
                                {
                                    <option value="@meeting.Id" data-label="@meeting.Title">@meeting.Title (@MeetingWeb.Services.DisplayTime.Format(meeting.CreatedAtUtc, "dd.MM.yyyy"))</option>
                                }
                            </select>
                        </div>
                        <div class="ask-dates">
                            <div class="ask-field">
                                <label asp-for="From">Başlangıç</label>
                                <input asp-for="From" type="date" class="ask-control" />
                            </div>
                            <div class="ask-field">
                                <label asp-for="To">Bitiş</label>
                                <input asp-for="To" type="date" class="ask-control" />
                            </div>
                        </div>
                        <div class="ask-scope-end">
                            <button type="button" class="ask-action" data-ask-scope-clear hidden>Tüm arşive dön</button>
                            <button type="button" class="ask-action ask-scope-done" data-ask-scope-done hidden>Tamam</button>
                        </div>
                    </div>
                </details>
                <span class="ask-count" data-ask-count hidden></span>
                <button type="submit" class="ask-send btn btn-grad" data-ask-send aria-label="Sor">
                    <span class="ask-send-go">@await Html.PartialAsync("_Icons", "send")</span>
                    <span class="ask-send-stop">@await Html.PartialAsync("_Icons", "stop")</span>
                </button>
            </div>
        </form>
        <div class="ask-foot">
            <p>Her soru ayrı aranır, önceki mesajlar hatırlanmaz.</p>
            <a class="ask-action" href="/Ask" data-ask-new>@await Html.PartialAsync("_Icons", "plus")Yeni sohbet</a>
        </div>
    </div>

    <div class="ask-starters" data-ask-starters>
        @if (Model.Meetings.Count == 0)
        {
            <p class="ask-hint">Henüz özeti çıkmış bir toplantınız yok. <a href="/Upload">Bir kayıt yükleyin</a>, özeti hazır olunca burada sorabilirsiniz.</p>
        }
        @foreach (var starter in Model.Starters())
        {
            <button type="button" class="ask-starter" data-ask-starter data-scope="@starter.Scope" data-target="@starter.TargetId" hidden>@starter.Question</button>
        }
    </div>
    <p class="sr-only" role="status" data-ask-status></p>
</div>

@* ask.js clones these and sets every text with textContent. *@
<template id="ask-turn-template">
    <article class="ask-turn">
        <div class="ask-question">
            <h2 class="sr-only">Sorunuz</h2>
            <p class="ask-bubble" data-slot="question"></p>
            <p class="ask-asked-in" data-slot="scope"></p>
        </div>
        <div class="ask-reply is-thinking">
            <partial name="_BriefynMark" />
            <div class="ask-reply-body"><h2 class="sr-only">Briefyn'in cevabı</h2><div data-slot="answer"><p class="ask-waiting" data-slot="waiting"></p></div></div>
        </div>
    </article>
</template>
<template id="ask-problem-template">
    <div class="ask-answer">
        <div class="ask-text" data-ask-text></div>
        <div class="ask-after" data-ask-after>
            <div class="ask-actions">
                <button type="button" class="ask-action" data-ask-retry>@await Html.PartialAsync("_Icons", "retry")Tekrar sor</button>
                <a class="ask-action" data-slot="link" hidden></a>
            </div>
        </div>
    </div>
</template>

@section Scripts {
    <script src="~/js/ask.js" asp-append-version="true" defer></script>
}
