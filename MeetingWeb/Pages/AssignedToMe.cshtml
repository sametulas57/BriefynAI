@page
@model MeetingWeb.Pages.AssignedToMeModel
@{
    ViewData["Title"] = "Bana atananlar";

    async Task Section(string title, string icon, List<MeetingWeb.Pages.AssignedToMeModel.Row> rows, bool overdue = false)
    {
        if (rows.Count == 0) { await Task.CompletedTask; return; }
        <h6 class="text-uppercase text-muted fw-bold small mt-4 mb-3"><i class="bi @icon me-1"></i>@title (@rows.Count)</h6>
        foreach (var row in rows)
        {
            <div class="soft-card p-3 mb-2 d-flex flex-wrap align-items-center gap-3">
                <div class="flex-grow-1">
                    <div class="fw-medium text-dark text-break">@row.Text</div>
                    <div class="small text-muted mt-1">
                        <a asp-page="/Details" asp-route-id="@row.MeetingId" class="text-decoration-none">@row.MeetingTopic</a>
                        · @row.TeamName
                        @if (row.DueDate != null)
                        {
                            <span class="@(overdue ? "text-warning-emphasis fw-medium" : "")"> · @row.DueDate.Value.ToString("d MMMM yyyy", MeetingWeb.Services.DisplayTime.Culture)</span>
                        }
                    </div>
                </div>
                <form method="post" asp-page-handler="Complete" class="m-0">
                    <input type="hidden" name="taskId" value="@row.Id" />
                    <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-3"><i class="bi bi-check2 me-1"></i>Yapıldı</button>
                </form>
            </div>
        }
    }
}

<div class="container py-4" style="max-width: 860px;">
    @if (TempData["StatusMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-4">@TempData["StatusMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-light border shadow-sm rounded-4">@TempData["ErrorMessage"]</div>
    }

    <h3 class="fw-bold mb-1">Bana atananlar</h3>
    <p class="text-muted mb-0">Üyesi olduğunuz bütün ekiplerden size atanmış açık görevler.</p>

    @if (Model.Total == 0)
    {
        <div class="soft-card p-5 mt-4 text-center text-muted">
            <i class="bi bi-check2-circle fs-1 text-success d-block mb-2"></i>
            Şu anda size atanmış açık bir görev yok.
        </div>
    }
    else
    {
        await Section("Gecikenler", "bi-hourglass-bottom", Model.Overdue, overdue: true);
        await Section("Bugün", "bi-calendar-day", Model.Today);
        await Section("Yaklaşanlar", "bi-calendar-week", Model.Upcoming);
        await Section("Tarihi olmayanlar", "bi-calendar", Model.NoDate);
    }
</div>
