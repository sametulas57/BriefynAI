@using MeetingWeb.Services.PublicSite
@inject SiteCatalog Catalog
@* Footer: all navigation links come from the catalog in navigation order. Dropdown sections form columns; single-page sections sit below. *@
<footer class="bg-grad-foot text-neutral-content [&_:focus-visible]:outline-neutral-content">
    <div class="mx-auto w-full max-w-6xl px-4 pt-10 pb-6 sm:px-7 sm:pt-12">
        <nav aria-label="Site haritası" class="grid grid-cols-2 gap-x-6 gap-y-8 md:grid-cols-4 lg:grid-cols-[minmax(0,1.2fr)_repeat(4,minmax(0,1fr))]">
            <div class="col-span-2 md:col-span-4 lg:col-span-1">
                <a href="/tr" class="inline-flex min-h-11 items-center rounded-field">
                    <img src="/img/brand/logo-a-acik.svg" alt="Briefyn" width="113" height="22" class="h-5.5 w-auto" />
                </a>
            </div>
            @foreach (var menuSection in Catalog.Sections.Where(menuSection => menuSection.IsMenu))
            {
                <section aria-labelledby="pf-@menuSection.Key">
                    <h2 id="pf-@menuSection.Key" class="text-base font-bold text-hero-title">@menuSection.Title</h2>
                    <ul class="mt-2">
                        @foreach (var entry in menuSection.Entries)
                        {
                            <li>
                                <a href="@entry.Path" class="group inline-flex min-h-11 min-w-11 flex-wrap items-center gap-x-2 gap-y-1 py-1 leading-snug lg:min-h-9">
                                    <span class="underline-offset-4 group-hover:underline">@entry.Title</span>
                                    @if (!entry.Available)
                                    {
                                        <span class="badge badge-accent badge-sm font-bold">Yakında</span>
                                    }
                                </a>
                            </li>
                        }
                    </ul>
                </section>
            }
        </nav>
        <div class="mt-8 flex flex-col gap-x-7 border-t border-neutral-content/20 pt-3 sm:flex-row sm:flex-wrap sm:items-center">
            @foreach (var menuSection in Catalog.Sections.Where(menuSection => !menuSection.IsMenu))
            {
                <a href="@menuSection.Path" class="inline-flex min-h-11 min-w-11 items-center underline-offset-4 hover:underline">@menuSection.Title</a>
            }
            <a href="/Privacy" class="inline-flex min-h-11 min-w-11 items-center underline-offset-4 hover:underline">Gizlilik</a>
        </div>
    </div>
</footer>
