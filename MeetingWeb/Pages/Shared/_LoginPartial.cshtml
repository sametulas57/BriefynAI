@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@if (SignInManager.IsSignedIn(User))
{
    <form class="m-0" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })" method="post">
        <button type="submit" class="dropdown-item text-danger py-2" title="Çıkış yap"><i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Çıkış</button>
    </form>
}
else
{
    <ul class="navbar-nav flex-row align-items-center gap-2">
        <li class="nav-item"><a class="nav-link" asp-area="" asp-page="/Auth/Register">Kayıt Ol</a></li>
        <li class="nav-item"><a class="btn btn-primary px-3" asp-area="" asp-page="/Auth/Login">Giriş Yap</a></li>
    </ul>
}
