@model string
@* Public site icons: hand-drawn, without a library. Usage: @await Html.PartialAsync("_Icons", "chevron-down")
   Icons inherit the text color (currentColor); they are decorative and hidden from screen readers. *@
@switch (Model)
{
    case "chevron-down":
        <svg class="size-3.5 shrink-0" viewBox="0 0 14 14" aria-hidden="true" focusable="false"><path d="M3 5.25 7 9.25l4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        break;
    case "menu":
        <svg class="size-5 shrink-0" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M3 5.5h14M3 10h14M3 14.5h9" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
        break;
    case "lock":
        <svg class="size-5 shrink-0" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><rect x="4" y="9" width="12" height="8.5" rx="2" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M7 9V6.5a3 3 0 0 1 6 0V9" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
        break;
    case "close":
        <svg class="size-5 shrink-0" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M5 5l10 10M15 5 5 15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
        break;
    case "send":
        <svg class="size-5 shrink-0" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M10 16V4.5M4.75 9.5 10 4.25l5.25 5.25" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        break;
    case "stop":
        <svg class="size-5 shrink-0" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><rect x="5.5" y="5.5" width="9" height="9" rx="1.75" fill="currentColor" /></svg>
        break;
    case "copy":
        <svg class="size-4 shrink-0" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><rect x="7" y="7" width="9.5" height="9.5" rx="2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /><path d="M13 4.75A1.75 1.75 0 0 0 11.25 3.5h-6A1.75 1.75 0 0 0 3.5 5.25v6A1.75 1.75 0 0 0 4.75 13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        break;
    case "retry":
        <svg class="size-4 shrink-0" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M15.5 8A6 6 0 1 0 16 11.5M16 4v4h-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        break;
    case "plus":
        <svg class="size-4 shrink-0" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M10 4.5v11M4.5 10h11" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        break;
    case "filter":
        <svg class="size-4 shrink-0" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M3.5 6h13M6 10h8M8.5 14h3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        break;
    case "open":
        <svg class="size-4 shrink-0" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M8 4.5H5.25A1.75 1.75 0 0 0 3.5 6.25v8.5c0 .97.78 1.75 1.75 1.75h8.5a1.75 1.75 0 0 0 1.75-1.75V12M11.5 3.5h5v5M16.5 3.5 9 11" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        break;
}
