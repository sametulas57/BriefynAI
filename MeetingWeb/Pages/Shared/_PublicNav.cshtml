@using MeetingWeb.Services.PublicSite
@inject SiteCatalog Catalog
@* Top navigation. Titles, groups and links come from the catalog (Services/PublicSite/SiteCatalog.cs), not a list here.
   Dropdowns use <details> and work without scripts. public-nav.js adds Esc, outside-click handling and the mobile panel. *@
@{
    var currentPath = Context.Request.Path.Value;
    var signedIn = User.Identity?.IsAuthenticated == true;
    // Pages with dark chrome (the home page) use the logo variant for dark backgrounds in the navigation.
    var logo = ViewData["Chrome"] as string == "koyu" ? "/img/brand/logo-a-acik.svg" : "/img/brand/logo-a.svg";
}
<header class="pn-header border-b border-base-300 bg-base-100" data-public-nav>
    <div class="mx-auto flex min-h-16 w-full max-w-6xl flex-wrap items-center gap-x-5 px-4 sm:min-h-17 sm:px-7 lg:flex-nowrap">
        <a href="/tr" class="inline-flex min-h-11 shrink-0 items-center rounded-field">
            <img src="@logo" alt="Briefyn" width="134" height="26" class="h-5.5 w-auto sm:h-6.5" />
        </a>
        <button type="button" class="btn btn-ghost ml-auto min-h-11 gap-2 rounded-field px-3 text-base font-bold hover:bg-base-200 lg:hidden"
                data-nav-toggle aria-expanded="false" aria-controls="pn-menu">
            <span class="pn-icon-open">@await Html.PartialAsync("_Icons", "menu")</span>
            <span class="pn-icon-close">@await Html.PartialAsync("_Icons", "close")</span>
            Menü
        </button>
        <div id="pn-menu" class="pn-menu max-lg:basis-full max-lg:pb-5 lg:flex lg:flex-1 lg:items-center lg:gap-5">
            <nav aria-label="Ana menü" class="lg:flex-1">
                <ul class="flex flex-col lg:flex-row lg:items-center lg:gap-0.5">
                    @foreach (var menuSection in Catalog.Sections)
                    {
                        var hasCurrent = menuSection.Entries.Any(entry => entry.Path == currentPath);
                        <li class="relative max-lg:border-b max-lg:border-base-300">
                            @if (menuSection.IsMenu)
                            {
                                <details name="pn-menu" class="group" data-nav-menu>
                                    <summary class="pn-summary pn-trigger @(hasCurrent ? "is-current" : null)" aria-controls="pn-dd-@menuSection.Key" data-nav-section>@menuSection.Title<span class="inline-flex motion-safe:transition-transform group-open:rotate-180">@await Html.PartialAsync("_Icons", "chevron-down")</span></summary>
                                    <div id="pn-dd-@menuSection.Key" class="pn-panel @(menuSection.Groups.Count() > 1 ? "lg:grid lg:w-[46rem] lg:grid-cols-4 lg:gap-x-4" : "lg:w-76")">
                                        @{ var groupIndex = 0; }
                                        @foreach (var group in menuSection.Groups)
                                        {
                                            var groupId = $"pn-g-{menuSection.Key}-{groupIndex++}";
                                            <div class="max-lg:not-first:mt-2">
                                                @if (group.Key is not null)
                                                {
                                                    <p id="@groupId" class="px-2.5 pt-1.5 pb-1 text-sm font-bold text-muted" data-nav-group>@group.Key</p>
                                                }
                                                <ul aria-labelledby="@(group.Key is null ? null : groupId)">
                                                    @foreach (var entry in group)
                                                    {
                                                        <li>
                                                            <a href="@entry.Path" class="pn-link" aria-current="@(entry.Path == currentPath ? "page" : null)">
                                                                <span>@entry.Title</span>
                                                                @if (!entry.Available)
                                                                {
                                                                    <span class="badge badge-accent badge-sm shrink-0 font-bold">Yakında</span>
                                                                }
                                                            </a>
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        }
                                    </div>
                                </details>
                            }
                            else
                            {
                                <a href="@menuSection.Path" class="pn-trigger @(hasCurrent ? "is-current" : null)" data-nav-section aria-current="@(hasCurrent ? "page" : null)">@menuSection.Title</a>
                            }
                        </li>
                    }
                </ul>
            </nav>
            <div class="flex shrink-0 flex-col gap-3 max-lg:mt-6 lg:flex-row">
                <a href="/Upload" class="btn btn-grad h-12 px-6 text-base font-bold lg:hidden">Kayıt yükle</a>
                @if (signedIn)
                {
                    <a href="/History" class="btn btn-outline btn-secondary min-h-11 px-4 text-base max-lg:h-12">Toplantılarım</a>
                }
                else
                {
                    <a href="/Auth/Login" class="btn btn-outline btn-secondary min-h-11 px-4 text-base max-lg:h-12">Giriş yap</a>
                }
            </div>
        </div>
    </div>
</header>
