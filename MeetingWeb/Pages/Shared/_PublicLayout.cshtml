<!DOCTYPE html>
@* Pages requesting dark chrome (home page: ViewData["Chrome"] = "koyu") get dark navigation and page backgrounds; other pages stay light. *@
<html lang="tr" data-theme="briefyn" data-chrome="@(ViewData["Chrome"] as string)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    @if (ViewData["Robots"] is string robots)
    {
        <meta name="robots" content="@robots" />
    }
    <title>@ViewData["Title"] | Briefyn</title>
    <link rel="icon" type="image/svg+xml" href="/img/brand/favicon.svg" />
    <link rel="preload" href="/fonts/ibm-plex-sans/IBMPlexSansVar-Roman-Latin1.woff2" as="font" type="font/woff2" crossorigin />
    @* Page-specific head elements precede app.css: the home page places the scroll-craft engine styles in the lowest layer here. *@
    @await RenderSectionAsync("Head", required: false)
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    @* With scripts enabled, mobile navigation becomes a panel; otherwise it stays expanded in the page flow. *@
    <script>document.documentElement.classList.add("js")</script>
    <script src="~/js/public-nav.js" asp-append-version="true" defer></script>
</head>
<body class="flex min-h-screen flex-col bg-base-200 font-sans text-base-content antialiased">
    <partial name="_PublicNav" />
    <main class="flex-1">@RenderBody()</main>
    <partial name="_PublicFooter" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
