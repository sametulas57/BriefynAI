@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Identity
@using MeetingWeb.Data
@using Microsoft.EntityFrameworkCore
@inject IHttpContextAccessor HttpContextAccessor
@inject UserManager<MeetingWeb.Models.ApplicationUser> UserManager
@inject ApplicationDbContext DbContext
@inject MeetingWeb.Services.IActiveWorkspaceService ActiveWorkspace

@{
    // SECURITY & CONTEXT MANAGEMENT (S7): the active tenant is the session's choice only if the user is still a member.
    var userId = UserManager.GetUserId(User);
    var activeWorkspaceId = (await ActiveWorkspace.GetActiveMembershipAsync(userId))?.WorkspaceId;
    
    MeetingWeb.Models.WorkspaceRole? currentUserRole = null;
    string activeWorkspaceName = "Ekip";
    
    // Initialize collection to hold the user's authorized workspaces.
    var userWorkspaces = new List<MeetingWeb.Models.WorkspaceMember>();

    if (userId != null)
    {
        // 1. Eager load all workspaces where the current user holds membership.
        userWorkspaces = DbContext.WorkspaceMembers
            .Include(w => w.Workspace)
            .Where(w => w.UserId == userId)
            .ToList();

        // 2. Extract metadata for the active workspace to render in the navigation bar.
        var userRecord = userWorkspaces.FirstOrDefault(w => w.WorkspaceId == activeWorkspaceId);
            
        if (userRecord != null)
        {
            currentUserRole = userRecord.Role;
            activeWorkspaceName = userRecord.Workspace.Name;
        }
    }
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Briefyn AI</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MeetingWeb.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <style>
            .navbar-sticky {
                position: sticky;
                top: 0;
                z-index: 1020;
                background-color: #fff !important;
            }
            .navbar .nav-link { color: #495057; border-radius: .5rem; padding: .55rem .75rem; }
            .navbar .nav-link[aria-current="page"] { color: var(--bs-primary); background: rgba(var(--bs-primary-rgb), .09); font-weight: 600; }
            .account-menu { min-width: 290px; max-height: min(75vh, 560px); overflow-y: auto; }
            .account-menu .dropdown-item { border-radius: .4rem; }
            @@media (min-width: 992px) and (max-width: 1199.98px) {
                .navbar-brand { margin-right: .5rem !important; }
                .navbar-nav { gap: .25rem !important; }
                .navbar .gap-lg-3 { column-gap: .5rem !important; }
            }
            @@media (max-width: 991.98px) {
                .navbar-collapse { padding-top: .75rem; }
                .navbar-nav .nav-item { width: 100%; margin: 0 !important; }
                .navbar-nav .nav-link, .navbar-nav .btn { width: 100%; justify-content: flex-start !important; }
                .account-menu { width: 100%; }
            }
    </style>
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-light border-bottom navbar-sticky py-2" aria-label="Ana gezinme">
            <div class="container-fluid px-3 px-lg-4">
                <a class="navbar-brand fw-bold text-primary d-flex align-items-center gap-2 me-lg-4" asp-area="" asp-page="/Index">
                    <span class="bg-primary text-white rounded-3 d-flex align-items-center justify-content-center" style="width:32px;height:32px"><i class="bi bi-robot"></i></span>Briefyn AI
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Menüyü aç veya kapat"><span class="navbar-toggler-icon"></span></button>
                <div class="navbar-collapse collapse" id="mainNavbar">
                    <ul class="navbar-nav align-items-lg-center gap-lg-1">
                        @{ var currentPage = ViewContext.RouteData.Values["page"]?.ToString(); }
                        <li class="nav-item"><a class="nav-link @(currentPage == "/Index" ? "active" : "")" aria-current="@(currentPage == "/Index" ? "page" : null)" asp-area="" asp-page="/Index">Ana Sayfa</a></li>
                        @if (User.Identity!.IsAuthenticated)
                        {
                            <li class="nav-item"><a class="nav-link @(currentPage == "/History" ? "active" : "")" aria-current="@(currentPage == "/History" ? "page" : null)" asp-page="/History">Geçmiş Özetler</a></li>
                            <li class="nav-item"><a class="nav-link @(currentPage == "/MyActions" ? "active" : "")" aria-current="@(currentPage == "/MyActions" ? "page" : null)" asp-page="/MyActions">Bana Atananlar</a></li>
                            <li class="nav-item"><a class="nav-link @(currentPage?.StartsWith("/Series/") == true ? "active" : "")" aria-current="@(currentPage?.StartsWith("/Series/") == true ? "page" : null)" asp-page="/Series/Index">Seriler</a></li>
                            <li class="nav-item"><a class="nav-link @(currentPage == "/Ask" ? "active" : "")" aria-current="@(currentPage == "/Ask" ? "page" : null)" asp-page="/Ask">Arşive Sor</a></li>
                        }
                    </ul>
                    @if (User.Identity!.IsAuthenticated)
                    {
                        var fullName = User.Claims.FirstOrDefault(c => c.Type == MeetingWeb.Models.UserClaimTypes.FullName)?.Value ?? User.Identity?.Name ?? MeetingWeb.Services.UserDisplay.UnknownName;
                        var avatarUrl = User.Claims.FirstOrDefault(c => c.Type == MeetingWeb.Models.UserClaimTypes.AvatarUrl)?.Value;
                        var initials = MeetingWeb.Services.UserDisplay.Initials(fullName);
                        <div class="d-flex flex-column flex-lg-row align-items-stretch align-items-lg-center gap-2 gap-lg-3 ms-lg-auto mt-3 mt-lg-0">
                            <a class="btn btn-primary px-3" asp-area="" asp-page="/Upload"><i class="bi bi-cloud-arrow-up me-2" aria-hidden="true"></i>Yeni Kayıt Yükle</a>
                            @if (activeWorkspaceId != null) { <span class="small text-secondary text-truncate" style="max-width:180px" title="@activeWorkspaceName"><i class="bi bi-buildings me-1" aria-hidden="true"></i>@activeWorkspaceName</span> }
                            <div class="dropdown">
                                <button class="btn btn-light d-flex align-items-center gap-2 w-100" id="accountMenu" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Kullanıcı menüsü" title="Kullanıcı menüsü">
                                    @if (!string.IsNullOrEmpty(avatarUrl))
                                    {
                                        <img src="@avatarUrl" alt="" class="rounded-circle object-fit-cover" style="width:32px;height:32px" />
                                    }
                                    else
                                    {
                                        <span class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center fw-bold" style="width:32px;height:32px;font-size:.8rem" aria-hidden="true">@initials</span>
                                    }
                                    <span class="d-lg-none d-xl-inline">@fullName</span><i class="bi bi-chevron-down small ms-auto ms-lg-0" aria-hidden="true"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end account-menu p-2" aria-labelledby="accountMenu">
                                    <li><a class="dropdown-item py-2" asp-area="" asp-page="/Profile/Index"><i class="bi bi-person me-2" aria-hidden="true"></i>Profilim</a></li>
                                    @if (activeWorkspaceId != null)
                                    {
                                        <li><hr class="dropdown-divider"><h6 class="dropdown-header">@activeWorkspaceName</h6></li>
                                        <li><a class="dropdown-item py-2" asp-page="/Workspace/Members"><i class="bi bi-people me-2" aria-hidden="true"></i>Ekibi Görüntüle</a></li>
                                        @if (currentUserRole is { } navRole && MeetingWeb.Models.WorkspaceMember.RunsTeam(navRole)) { <li><a class="dropdown-item py-2" asp-page="/Workspace/Invite"><i class="bi bi-link-45deg me-2" aria-hidden="true"></i>Davet Linki Üret</a></li> }
                                    }
                                    <li><a class="dropdown-item py-2" asp-page="/Workspace/Create"><i class="bi bi-plus-circle me-2" aria-hidden="true"></i>Yeni Ekip Oluştur</a></li>
                                    @if (userWorkspaces.Count > 0)
                                    {
                                        <li><hr class="dropdown-divider"><h6 class="dropdown-header">Ekip Değiştir</h6></li>
                                        @foreach (var ws in userWorkspaces) { <li><a class="dropdown-item py-2 @(ws.WorkspaceId == activeWorkspaceId ? "text-primary fw-semibold" : "")" href="/Workspace/Switch?workspaceId=@ws.WorkspaceId&returnUrl=@Context.Request.Path">@if (ws.WorkspaceId == activeWorkspaceId) { <i class="bi bi-check2 me-2" aria-hidden="true"></i> }@ws.Workspace.Name</a></li> }
                                    }
                                    <li><hr class="dropdown-divider"><partial name="_LoginPartial" /></li>
                                </ul>
                            </div>
                        </div>
                    }
                    else { <div class="ms-lg-auto mt-3 mt-lg-0"><partial name="_LoginPartial" /></div> }
                </div>
            </div>
        </nav>
    </header>
    
    <div class="container flex-grow-1">
        <main role="main" class="pb-5 pt-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-white mt-auto py-4">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
            <span class="fw-medium text-dark">&copy; 2026 - Briefyn AI</span>
            <div class="d-flex gap-4">
                <a asp-area="" asp-page="/Privacy" class="text-muted text-decoration-none hover-primary transition-all">Gizlilik Politikası</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ConfirmModal" />

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
