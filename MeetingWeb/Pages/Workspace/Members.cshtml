@page
@model MeetingWeb.Pages.Workspace.MembersModel
@{
    ViewData["Title"] = "Ekip Yönetimi";

    // Icon picker: the icons are shown as shapes in a grid (a plain list can only show their names); the chosen one
    // goes into the form's titleIcon field.
    void IconPicker(string? selected)
    {
        <input type="hidden" name="titleIcon" value="@selected" />
        <div class="dropdown">
            <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3 icon-picker-button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="İkon seç" title="İkon seç">
                <i class="bi bi-@(selected ?? "slash-circle")"></i><i class="bi bi-chevron-down ms-2" style="font-size: 0.7rem;"></i>
            </button>
            <div class="dropdown-menu p-2 shadow-sm border-0 rounded-3">
                <div class="icon-grid">
                    <button type="button" class="btn btn-sm icon-choice @(selected == null ? "btn-primary" : "btn-light")" data-icon="" title="İkon yok" aria-label="İkon yok">
                        <i class="bi bi-slash-circle"></i>
                    </button>
                    @foreach (var icon in MeetingWeb.Models.TitleIcons.All)
                    {
                        <button type="button" class="btn btn-sm icon-choice @(icon.Icon == selected ? "btn-primary" : "btn-light")" data-icon="@icon.Icon" title="@icon.Label" aria-label="@icon.Label">
                            <i class="bi bi-@icon.Icon"></i>
                        </button>
                    }
                </div>
            </div>
        </div>
    }
}

<div class="container mt-5 mb-5">
    
    @if (TempData["StatusMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-3 d-flex align-items-center" role="alert">
            <i class="bi bi-check-circle-fill fs-5 me-3 text-success"></i>
            <div>@TempData["StatusMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 rounded-3 d-flex align-items-center" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5 me-3 text-danger"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <h2 class="mb-0 text-dark fw-bold">
            <i class="bi bi-people-fill text-primary me-2"></i> @Model.WorkspaceName Ekibi
        </h2>
        
        <div class="d-flex gap-2">
            @if (Model.CurrentUserRole == MeetingWeb.Models.WorkspaceRole.Owner && !Model.IsPersonalWorkspace)
            {
                <button type="button" class="btn btn-outline-danger fw-bold shadow-sm rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#deleteWorkspaceModal">
                    <i class="bi bi-trash3 me-1"></i> Ekibi Sil
                </button>
            }
            
            @if (Model.CurrentUserRole is { } myRole && MeetingWeb.Models.WorkspaceMember.RunsTeam(myRole))
            {
                <a asp-page="/Workspace/Invite" class="btn btn-primary fw-bold shadow-sm rounded-pill px-4">
                    <i class="bi bi-person-plus-fill me-1"></i> Yeni Üye Davet Et
                </a>
            }
            else
            {
                <span class="d-inline-block" tabindex="0" data-bs-toggle="tooltip" title="Davet bağlantısını yalnız ekip kurucusu ve yöneticiler oluşturabilir">
                    <button class="btn btn-secondary fw-bold rounded-pill px-4 opacity-50" type="button" disabled style="pointer-events: none;">
                        <i class="bi bi-lock-fill me-1"></i> Yeni Üye Davet Et
                    </button>
                </span>
            }
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <ul class="list-group list-group-flush">
                @foreach (var member in Model.TeamMembers)
                {
                    var fullName = Model.UserNames.ContainsKey(member.UserId) ? Model.UserNames[member.UserId] : MeetingWeb.Services.UserDisplay.UnknownName;
                    var avatarUrl = Model.UserAvatars.ContainsKey(member.UserId) ? Model.UserAvatars[member.UserId] : null;

                    var initials = MeetingWeb.Services.UserDisplay.Initials(fullName);

                    <li class="list-group-item d-flex flex-column flex-md-row justify-content-between align-items-md-center p-4 bg-transparent border-bottom border-light hover-bg-light transition-all">
        
                        <div class="d-flex align-items-center mb-3 mb-md-0">
                            @if (!string.IsNullOrEmpty(avatarUrl))
                            {
                                <img src="@avatarUrl" class="rounded-circle shadow-sm me-4 border" style="width: 55px; height: 55px; object-fit: cover;" alt="@fullName" />
                            }
                            else
                            {
                                <div class="bg-primary bg-gradient text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm me-4" style="width: 55px; height: 55px; font-size: 1.3rem; font-weight: bold;">
                                    @initials
                                </div>
                            }

                            <div>
                                <div class="fs-5 fw-bold text-dark d-flex align-items-center flex-wrap gap-2 mb-1">
                                    @fullName
                    
                                    @if (member.Role == MeetingWeb.Models.WorkspaceRole.Owner)
                                    {
                                        <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill border border-primary border-opacity-25" style="font-size: 0.75rem;">
                                            <i class="bi bi-star-fill me-1"></i> Kurucu
                                        </span>
                                    }
                                    else if (member.Role == MeetingWeb.Models.WorkspaceRole.Admin)
                                    {
                                        <span class="badge bg-dark bg-opacity-10 text-dark rounded-pill border border-dark border-opacity-25" style="font-size: 0.75rem;">
                                            <i class="bi bi-shield-check me-1"></i> Yönetici
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill border border-secondary border-opacity-25" style="font-size: 0.75rem;">
                                            Üye
                                        </span>
                                    }

                                    @if (member.UserId == Model.CurrentUserId)
                                    {
                                        <span class="badge bg-success text-white rounded-pill shadow-sm" style="font-size: 0.75rem;">
                                            Sen
                                        </span>
                                    }

                                    <span class="badge bg-light text-dark rounded-pill border member-title @(member.Title == null ? "d-none" : "")" style="font-size: 0.75rem;"><i class="bi bi-@member.Title?.Icon me-1 @(member.Title?.Icon == null ? "d-none" : "")"></i><span>@member.Title?.Name</span></span>
                                </div>
                                <div class="text-muted small fw-medium">
                                    <i class="bi bi-envelope text-secondary me-1"></i> @member.User.Email
                                </div>
                            </div>
                        </div>

                        <div class="member-actions mt-3 mt-md-0 ms-md-4 d-flex justify-content-md-end gap-2">
                            @if (Model.CanManageTitles && Model.Titles.Count > 0)
                            {
                                <form method="post" asp-page-handler="AssignTitle" class="assign-title-form" autocomplete="off">
                                    <input type="hidden" name="targetUserId" value="@member.UserId" />
                                    <select name="titleId" class="form-select form-select-sm rounded-pill" aria-label="Unvan">
                                        <option value="">Unvansız</option>
                                        @foreach (var title in Model.Titles)
                                        {
                                            <option value="@title.Id" selected="@(title.Id == member.TitleId)">@title.Name</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-outline-secondary btn-sm fw-bold rounded-pill px-3">Kaydet</button>
                                    <span class="assign-note small fw-medium d-none" role="status"></span>
                                </form>
                            }
                            @if ((Model.CurrentUserRole == MeetingWeb.Models.WorkspaceRole.Owner && member.UserId != Model.CurrentUserId) ||
                                 (Model.CurrentUserRole == MeetingWeb.Models.WorkspaceRole.Admin && member.Role == MeetingWeb.Models.WorkspaceRole.Member))
                            {
                                <div class="dropdown member-actions-menu">
                                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-circle" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Diğer işlemler">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-end shadow-sm">
                            @if (Model.CurrentUserRole == MeetingWeb.Models.WorkspaceRole.Owner && member.UserId != Model.CurrentUserId)
                            {
                                @if (!Model.IsPersonalWorkspace)
                                {
                                <form method="post" asp-page-handler="TransferOwnership" data-confirm-title="Kuruculuğu devret" data-confirm-button="Evet, devret" data-confirm="Kuruculuk @fullName adlı kişiye geçer, sen üye olursun. Geri almak için onun kuruculuğu sana devretmesi gerekir.">
                                    <input type="hidden" name="targetUserId" value="@member.UserId" />
                                    <button type="submit" class="dropdown-item">Kuruculuğu Devret</button>
                                </form>
                                <form method="post" asp-page-handler="SetRole" data-confirm-safe data-confirm-title="@(member.Role == MeetingWeb.Models.WorkspaceRole.Member ? "Yönetici yap" : "Üye yap")" data-confirm-button="Evet" data-confirm="@(member.Role == MeetingWeb.Models.WorkspaceRole.Member ? $"{fullName} yönetici olur: davet gönderebilir, üye çıkarabilir, unvanları yönetebilir." : $"{fullName} üye olur; davet gönderme, üye çıkarma ve unvan yönetme yetkisi kalkar.")">
                                    <input type="hidden" name="targetUserId" value="@member.UserId" />
                                    <input type="hidden" name="makeAdmin" value="@(member.Role == MeetingWeb.Models.WorkspaceRole.Member ? "true" : "false")" />
                                    <button type="submit" class="dropdown-item">
                                        @(member.Role == MeetingWeb.Models.WorkspaceRole.Member ? "Yönetici Yap" : "Üye Yap")
                                    </button>
                                </form>
                                }
                                <div class="dropdown-divider"></div>
                                <form method="post" asp-page-handler="RemoveMember" data-confirm-title="Ekipten çıkar" data-confirm-button="Evet, çıkar" data-confirm="@fullName ekipten çıkarılır ve bu ekibin toplantılarını artık göremez.">
                                    <input type="hidden" name="targetUserId" value="@member.UserId" />
                                    <button type="submit" class="dropdown-item text-danger">
                                        <i class="bi bi-person-dash me-1"></i> Ekipten Çıkar
                                    </button>
                                </form>
                            }
                            else if (Model.CurrentUserRole == MeetingWeb.Models.WorkspaceRole.Admin && member.Role == MeetingWeb.Models.WorkspaceRole.Member)
                            {
                                <form method="post" asp-page-handler="RemoveMember" data-confirm-title="Ekipten çıkar" data-confirm-button="Evet, çıkar" data-confirm="@fullName ekipten çıkarılır ve bu ekibin toplantılarını artık göremez.">
                                    <input type="hidden" name="targetUserId" value="@member.UserId" />
                                    <button type="submit" class="dropdown-item text-danger">
                                        <i class="bi bi-person-dash me-1"></i> Ekipten Çıkar
                                    </button>
                                </form>
                            }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <span class="member-actions-spacer" aria-hidden="true"></span>
                            }

                            @if (Model.CurrentUserRole != MeetingWeb.Models.WorkspaceRole.Owner && member.UserId == Model.CurrentUserId)
                            {
                                <form method="post" asp-page-handler="LeaveWorkspace" class="d-inline" data-confirm-title="Ekipten ayrıl" data-confirm-button="Evet, ayrıl" data-confirm="Bu ekipten ayrılırsın ve ekibin toplantılarını artık göremezsin. Geri dönmek için yeni bir davet gerekir.">
                                    <button type="submit" class="btn btn-danger btn-sm fw-bold rounded-pill px-4 shadow-sm hover-scale">
                                        <i class="bi bi-box-arrow-right me-1"></i> Ekipten Ayrıl
                                    </button>
                                </form>
                            }
                        </div>
                    </li>
                }
            </ul>
        </div>
    </div>

    @if (Model.CanManageTitles)
    {
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden mt-4">
            <div class="card-body p-4">
                <h5 class="fw-bold text-dark mb-1"><i class="bi bi-tags text-primary me-2"></i>Unvanlar</h5>
                <p class="text-muted small mb-4">Birim ya da meslek olabilir; ekibinize kalmış. Unvan yetki vermez, rapor paylaşırken kişileri gruplar.</p>

                @foreach (var title in Model.Titles)
                {
                    <div class="title-row d-grid gap-2 align-items-center mb-2">
                        <form method="post" asp-page-handler="UpdateTitle" class="contents">
                            <input type="hidden" name="titleId" value="@title.Id" />
                            <input type="text" name="titleName" value="@title.Name" maxlength="@MeetingWeb.Models.WorkspaceTitle.NameMaxLength" class="form-control form-control-sm rounded-pill" aria-label="Unvan adı" required />
                            @{ IconPicker(title.Icon); }
                            <button type="submit" class="btn btn-outline-primary btn-sm fw-bold rounded-pill px-3">Kaydet</button>
                        </form>
                        <form method="post" asp-page-handler="DeleteTitle" class="title-delete" data-confirm-title="Unvanı sil" data-confirm-button="Evet, sil" data-confirm="&quot;@title.Name&quot; unvanı silinir. Bu unvanı taşıyanlar ekipte kalır, yalnız unvanları kalkar.">
                            <input type="hidden" name="titleId" value="@title.Id" />
                            <button type="submit" class="btn btn-outline-danger btn-sm fw-bold rounded-pill px-3"><i class="bi bi-trash3 me-1"></i>Sil</button>
                        </form>
                    </div>
                }

                <form method="post" asp-page-handler="CreateTitle" class="title-row title-create d-grid gap-2 align-items-center mt-3 pt-3 border-top">
                    <input type="text" name="titleName" maxlength="@MeetingWeb.Models.WorkspaceTitle.NameMaxLength" class="form-control form-control-sm rounded-pill" placeholder="Yeni unvan (ör. Yazılım, Hukuk)" aria-label="Yeni unvan" required />
                    @{ IconPicker(null); }
                    <button type="submit" class="btn btn-primary btn-sm fw-bold rounded-pill px-3"><i class="bi bi-plus-lg me-1"></i>Ekle</button>
                </form>
            </div>
        </div>
    }
</div>

@if (Model.CurrentUserRole == MeetingWeb.Models.WorkspaceRole.Owner && !Model.IsPersonalWorkspace)
{
    <div class="modal fade" id="deleteWorkspaceModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-danger text-white border-0 py-4">
                    <h5 class="modal-title fw-bold" id="deleteModalLabel"><i class="bi bi-exclamation-octagon-fill me-2"></i> Tehlikeli Bölge</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 bg-light">
                    <h5 class="text-danger fw-bold mb-3">Ekibi Tamamen Sil</h5>
                    <p class="text-muted" style="line-height: 1.7;">
                        Bu işlem <strong>kesinlikle geri alınamaz.</strong> Ekibi sildiğinizde içerideki tüm takım arkadaşlarınız ekipten atılacak, tüm açık davet linkleri iptal edilecek ve bu alana ait tüm toplantı özetleri sistemden kalıcı olarak yok olacaktır.
                    </p>
                    <div class="alert alert-warning border-0 rounded-3 mt-4 mb-0">
                        <i class="bi bi-info-circle-fill me-2"></i> Gerçekten bu ekibi kalıcı olarak silmek istediğinize emin misiniz?
                    </div>
                </div>
                <div class="modal-footer bg-white border-top py-3">
                    <button type="button" class="btn btn-light rounded-pill px-4 fw-bold" data-bs-dismiss="modal">Vazgeç</button>
                    <form method="post" asp-page-handler="DeleteWorkspace">
                        <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold shadow-sm">
                            <i class="bi bi-trash3-fill me-1"></i> Evet, Kalıcı Olarak Sil
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        // Initialize Bootstrap Tooltips for disabled elements
        document.addEventListener("DOMContentLoaded", function () {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl)
            });
        });

        // Icon picker: the menu is positioned "fixed" so the card's rounded edge does not cut it; clicking a shape stores
        // it in the form and shows it on the picker's button.
        document.querySelectorAll('.icon-picker-button').forEach(button =>
            new bootstrap.Dropdown(button, { popperConfig: config => ({ ...config, strategy: 'fixed' }) }));
        document.querySelectorAll('.member-actions-menu > button').forEach(button =>
            new bootstrap.Dropdown(button, { popperConfig: config => ({ ...config, strategy: 'fixed' }) }));
        document.querySelectorAll('.icon-choice').forEach(choice => choice.addEventListener('click', () => {
            const form = choice.closest('form');
            form.querySelector('input[name="titleIcon"]').value = choice.dataset.icon;
            form.querySelector('.icon-picker-button i').className = 'bi bi-' + (choice.dataset.icon || 'slash-circle');
            form.querySelectorAll('.icon-choice').forEach(c => {
                c.classList.toggle('btn-primary', c === choice);
                c.classList.toggle('btn-light', c !== choice);
            });
        }));

        // Saving one person's title updates only that row, so a choice made in another row is not lost (no page reload).
        document.querySelectorAll('form.assign-title-form').forEach(form => form.addEventListener('submit', async e => {
            e.preventDefault();
            const row = form.closest('li');
            const note = form.querySelector('.assign-note');
            // The row's fields stay locked until the answer arrives, so the answer always matches what is on screen.
            const fields = [...form.querySelectorAll('select, input:not([type="hidden"]), button')];
            if (fields[0].disabled) return;
            const body = new FormData(form);
            fields.forEach(f => f.disabled = true);
            const unlock = () => fields.forEach(f => f.disabled = false);
            let response;
            try {
                response = await fetch(form.action, { method: 'POST', body, headers: { 'Accept': 'application/json' } });
            } catch {
                // No connection: say so in the row and keep every choice on the page.
                unlock();
                note.textContent = 'Bağlantı kurulamadı, kaydedilmedi. Lütfen tekrar deneyin.';
                note.className = 'assign-note small fw-medium text-danger';
                return;
            }
            let data;
            try {
                data = await response.json();
            } catch {
                // Not a short answer (e.g. the session ended): show the page as it now is.
                location.reload();
                return;
            }
            unlock();
            note.textContent = data.message;
            note.className = 'assign-note small fw-medium ' + (data.success ? 'text-success' : 'text-danger');
            if (!data.success) return;

            const badge = row.querySelector('.member-title');
            const icon = badge.querySelector('i');
            badge.querySelector('span').textContent = data.name || '';
            badge.classList.toggle('d-none', !data.name);
            icon.className = 'bi me-1 ' + (data.icon ? 'bi-' + data.icon : 'd-none');
        }));
    </script>
}
