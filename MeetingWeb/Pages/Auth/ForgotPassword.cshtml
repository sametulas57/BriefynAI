@page
@model MeetingWeb.Pages.Auth.ForgotPasswordModel
@{
    ViewData["Title"] = "Şifremi Unuttum";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <!-- Header Section -->
                <div class="bg-primary bg-gradient text-white text-center py-4">
                    <h2 class="fw-bold mb-0">Şifrenizi mi unuttunuz?</h2>
                    <p class="mb-0 mt-1 opacity-75 fs-6">E-posta adresinizi yazın, size yeni şifre belirleme bağlantısı gönderelim.</p>
                </div>

                <div class="card-body p-5 bg-white">
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger rounded-3" role="alert">@TempData["ErrorMessage"]</div>
                    }

                    @if (Model.Sent)
                    {
                        <div class="alert alert-success rounded-3" role="status">
                            <i class="bi bi-envelope-check me-1" aria-hidden="true"></i>
                            Bu adrese kayıtlı bir hesap varsa, şifrenizi yenilemeniz için bir bağlantı gönderdik. E-postanızı kontrol edin; bağlantı @Model.LinkLifetimeText geçerli.
                        </div>
                        <p class="text-muted small mb-4">E-posta birkaç dakika içinde gelmezse gereksiz klasörüne de bakın.</p>

                        <div class="text-center">
                            <a asp-page="/Auth/ForgotPassword" class="text-primary fw-bold text-decoration-none hover-primary transition-all">Başka bir adres dene</a>
                        </div>
                    }
                    else
                    {
                        <form method="post">
                            <!-- Validation Summary Alert -->
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm rounded-3 border-0 py-2 px-3 mb-4 d-none d-flex align-items-center" role="alert">
                                <i class="bi bi-shield-x me-2 fs-5" aria-hidden="true"></i>
                            </div>

                            <div class="form-floating mb-4">
                                <input asp-for="Input.Email" class="form-control rounded-3 focus-ring-primary bg-light border-0" type="email" placeholder="ad@sirket.com" autocomplete="email" autofocus />
                                <label asp-for="Input.Email" class="text-muted"><i class="bi bi-envelope me-1" aria-hidden="true"></i> E-Posta Adresi</label>
                                <span asp-validation-for="Input.Email" class="text-danger fw-bold small ms-1 mt-1 d-block"></span>
                            </div>

                            <button type="submit" class="btn btn-primary w-100 btn-lg rounded-pill shadow-sm fw-bold hover-scale transition-all d-flex align-items-center justify-content-center">
                                <i class="bi bi-envelope-arrow-up me-2" aria-hidden="true"></i> Bağlantı Gönder
                            </button>
                        </form>
                    }

                    <div class="text-center mt-4 pt-3 border-top border-light">
                        <span class="text-muted">Şifrenizi hatırladınız mı?</span>
                        <a asp-page="/Auth/Login" class="text-primary fw-bold text-decoration-none ms-1 hover-primary transition-all">Giriş yapın</a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <!-- Client-side validation scripts -->
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Unhide validation summary if server-side errors exist
        document.addEventListener("DOMContentLoaded", function () {
            var validationSummary = document.querySelector(".validation-summary-errors");
            if (validationSummary) {
                validationSummary.classList.remove("d-none");
            }
        });
    </script>
}
