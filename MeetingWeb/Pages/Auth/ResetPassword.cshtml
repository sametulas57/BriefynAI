@page
@model MeetingWeb.Pages.Auth.ResetPasswordModel
@{
    ViewData["Title"] = "Yeni Şifre Belirle";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <!-- Header Section -->
                <div class="bg-primary bg-gradient text-white text-center py-4">
                    <h2 class="fw-bold mb-0">Yeni şifrenizi belirleyin</h2>
                    <p class="mb-0 mt-1 opacity-75 fs-6">Hesabınız için yeni bir şifre seçin.</p>
                </div>

                <div class="card-body p-5 bg-white">
                    @if (!Model.LinkValid)
                    {
                        <div class="alert alert-warning rounded-3 mb-4" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-1" aria-hidden="true"></i>
                            Bu bağlantı artık geçerli değil. Süresi dolmuş ya da daha önce kullanılmış olabilir.
                        </div>

                        <a asp-page="/Auth/ForgotPassword" class="btn btn-primary w-100 btn-lg rounded-pill shadow-sm fw-bold hover-scale transition-all d-flex align-items-center justify-content-center">
                            <i class="bi bi-envelope-arrow-up me-2" aria-hidden="true"></i> Yeni bağlantı iste
                        </a>
                    }
                    else
                    {
                        <form method="post">
                            <!-- Validation Summary Alert -->
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm rounded-3 border-0 py-2 px-3 mb-4 d-none d-flex align-items-center" role="alert">
                                <i class="bi bi-shield-x me-2 fs-5" aria-hidden="true"></i>
                            </div>

                            <input type="hidden" asp-for="Input.UserId" />
                            <input type="hidden" asp-for="Input.Code" />

                            <div class="form-floating mb-3">
                                <input asp-for="Input.Password" class="form-control rounded-3 focus-ring-primary bg-light border-0" type="password" placeholder="Yeni Şifre" autocomplete="new-password" aria-describedby="passwordHint" autofocus />
                                <label asp-for="Input.Password" class="text-muted"><i class="bi bi-shield-lock me-1" aria-hidden="true"></i> Yeni Şifre</label>
                                <span asp-validation-for="Input.Password" class="text-danger fw-bold small ms-1 mt-1 d-block"></span>
                            </div>

                            <div class="form-floating mb-2">
                                <input asp-for="Input.ConfirmPassword" class="form-control rounded-3 focus-ring-primary bg-light border-0" type="password" placeholder="Yeni Şifre (Tekrar)" autocomplete="new-password" />
                                <label asp-for="Input.ConfirmPassword" class="text-muted"><i class="bi bi-shield-check me-1" aria-hidden="true"></i> Yeni Şifre (Tekrar)</label>
                                <span asp-validation-for="Input.ConfirmPassword" class="text-danger fw-bold small ms-1 mt-1 d-block"></span>
                            </div>

                            <p id="passwordHint" class="text-muted small ms-1 mb-4">En az 6 karakter; büyük harf, küçük harf, rakam ve bir işaret (ör. !) içermeli.</p>

                            <button type="submit" class="btn btn-primary w-100 btn-lg rounded-pill shadow-sm fw-bold hover-scale transition-all d-flex align-items-center justify-content-center">
                                <i class="bi bi-shield-check me-2" aria-hidden="true"></i> Şifremi Kaydet
                            </button>
                        </form>
                    }

                    <div class="text-center mt-4 pt-3 border-top border-light">
                        <a asp-page="/Auth/Login" class="text-primary fw-bold text-decoration-none hover-primary transition-all">Giriş sayfasına dön</a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <!-- Client-side validation scripts -->
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Unhide validation summary if server-side errors exist
        document.addEventListener("DOMContentLoaded", function () {
            var validationSummary = document.querySelector(".validation-summary-errors");
            if (validationSummary) {
                validationSummary.classList.remove("d-none");
            }
        });
    </script>
}
