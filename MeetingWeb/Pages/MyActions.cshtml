@page
@model MeetingWeb.Pages.MyActionsModel
@using MeetingWeb.Services
@{
    ViewData["Title"] = "Bana Atananlar";
}

<style>
    .soft-card {
        background: #ffffff;
        border: 1px solid rgba(0, 0, 0, 0.04);
        border-radius: 1.25rem;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.02);
    }
    .bg-soft-primary { background-color: rgba(13, 110, 253, 0.04) !important; }
    .bg-soft-danger { background-color: rgba(220, 53, 69, 0.04) !important; }
    .bg-soft-light { background-color: #f8f9fa !important; }
    .icon-container {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
    }
</style>

<div class="container mt-5 mb-5" style="max-width: 900px;">

    @if (TempData["StatusMessage"] != null)
    {
        <div class="alert bg-soft-primary text-primary border-0 rounded-4 d-flex align-items-center mb-4 p-3 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill fs-5 me-3"></i>
            <div class="fw-medium">@TempData["StatusMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert bg-soft-danger text-danger border-0 rounded-4 d-flex align-items-center mb-4 p-3 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5 me-3"></i>
            <div class="fw-medium">@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }

    <div class="d-flex align-items-center mb-5 mt-3">
        <div class="icon-container bg-primary bg-opacity-10 text-primary me-3">
            <i class="bi bi-person-check fs-4"></i>
        </div>
        <div>
            <h2 class="mb-0 text-dark fw-bold" style="letter-spacing: -0.5px;">Bana Atananlar</h2>
            <p class="text-muted mb-0 small">Hangi ekipte, hangi toplantıda size hangi görevin verildiğini burada görürsünüz.</p>
        </div>
    </div>

    @if (Model.Open.Count == 0 && Model.Done.Count == 0)
    {
        <div class="soft-card p-5 text-center text-muted">
            <i class="bi bi-inbox fs-1 d-block mb-3"></i>
            Size atanmış bir görev yok. Bir toplantı özetinde görev size atandığında burada görünür.
        </div>
    }

    @if (Model.Open.Count > 0)
    {
        <h5 class="fw-bold text-dark mb-3">Yapılacaklar (@Model.Open.Count)</h5>
        <div class="d-flex flex-column gap-3 mb-5">
            @foreach (var t in Model.Open)
            {
                <div class="soft-card p-4 d-flex flex-column flex-md-row align-items-md-center gap-3">
                    <div class="flex-grow-1">
                        <div class="fw-semibold text-dark text-break mb-2">@t.Text</div>
                        <div class="small text-muted d-flex flex-wrap gap-3">
                            <span><i class="bi bi-people me-1"></i>@t.Team</span>
                            <a asp-page="/Details" asp-route-id="@t.MeetingId" class="text-muted text-decoration-none"><i class="bi bi-camera-video me-1"></i>@t.Meeting</a>
                            @if (t.DueDate != null)
                            {
                                <span><i class="bi bi-calendar-event me-1"></i>Son tarih: @t.DueDate.Value.ToString("d MMMM yyyy", DisplayTime.Culture)</span>
                            }
                        </div>
                    </div>
                    <form method="post" asp-page-handler="Complete" class="flex-shrink-0">
                        <input type="hidden" name="taskId" value="@t.Id" />
                        <button type="submit" class="btn btn-success rounded-pill px-4 fw-semibold"><i class="bi bi-check2 me-1"></i>Tamamlandı</button>
                    </form>
                </div>
            }
        </div>
    }

    @if (Model.Done.Count > 0)
    {
        <h5 class="fw-bold text-dark mb-3">Tamamladıklarım (@Model.Done.Count)</h5>
        <div class="d-flex flex-column gap-2">
            @foreach (var t in Model.Done)
            {
                <div class="soft-card p-3 px-4 d-flex flex-column flex-md-row align-items-md-center gap-2 bg-soft-light">
                    <div class="flex-grow-1">
                        <div class="text-muted text-decoration-line-through text-break">@t.Text</div>
                        <div class="small text-muted d-flex flex-wrap gap-3 mt-1">
                            <span><i class="bi bi-people me-1"></i>@t.Team</span>
                            <a asp-page="/Details" asp-route-id="@t.MeetingId" class="text-muted text-decoration-none"><i class="bi bi-camera-video me-1"></i>@t.Meeting</a>
                            @if (t.CompletedAtUtc != null)
                            {
                                <span class="text-success"><i class="bi bi-check2-circle me-1"></i>@DisplayTime.Format(t.CompletedAtUtc.Value, "d MMMM yyyy")</span>
                            }
                        </div>
                    </div>
                    <form method="post" asp-page-handler="Reopen" class="flex-shrink-0">
                        <input type="hidden" name="taskId" value="@t.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill px-3">Geri al</button>
                    </form>
                </div>
            }
        </div>
    }
</div>
