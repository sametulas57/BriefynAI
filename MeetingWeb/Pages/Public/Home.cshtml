@page "/tr"
@model MeetingWeb.Pages.Public.HomeModel
@{
    ViewData["Title"] = "Toplantıyı siz yapın, notları Briefyn çıkarsın";
    // Kayan şerit: Briefyn her toplantının ses kaydını aynı yoldan işler; türe özel bir iddia yok (BRIEF 9. bölüm, satır 5).
    string[] meetings =
    [
        "Haftalık ekip toplantısı", "Sprint planlama", "Müşteri görüşmesi", "Birebir görüşme", "İşe alım mülakatı",
        "Proje başlangıcı", "Satış görüşmesi", "Yönetim toplantısı", "Ajans sunumu", "Geriye dönük değerlendirme"
    ];
    // Açılıştaki durgun ses dalgası (süs): çubuk boyları elle seçildi, konuşma gibi inip çıkıyor.
    int[] heroBars = [14, 30, 22, 48, 70, 40, 92, 58, 108, 76, 44, 96, 64, 110, 84, 52, 100, 68, 36, 80, 56, 28, 42, 18];
    // Yolculuğun adımları. Her cümlenin dayandığı özellik BRIEF.md 9. bölümdeki tabloda (satır 7-12).
    // "End", adımın bittiği kaydırma payı: home.js sahnenin o anki hâlini bu değerden hesaplar.
    (string Name, string Sentence, string Cue, string End)[] steps =
    [
        // İpucu pencereleri art arda: biri sönerken öteki gelmez, iki metin üst üste binmez (her geçiş yaklaşık 0,03 pay).
        ("Yükleme", "Kaydı yükleyin ya da Zoom'dan tek tıkla aktarın.", "0.09 0.23 0.1 0.1", "0.22"),
        ("Yazıya dökme", "Konuşulan her şey okunabilir bir metne dönüşür.", "0.23 0.425 0.08 0.06", "0.40"),
        ("Konuşmacılar", "Konuşmacılar birbirinden ayrılır, her birine adını siz verirsiniz.", "0.425 0.55 0.1 0.1", "0.54"),
        ("Özet, kararlar, yapılacaklar", "Özet, kararlar ve yapılacaklar tek sayfada toplanır; işler kişilere atanır.", "0.55 0.70 0.09 0.09", "0.70"),
        ("Arşive sor", "Geçmiş toplantılarınıza soru sorun; cevap, geldiği toplantıyla birlikte gelir.", "0.70 0.86 0.09 0.09", "0.86"),
        // Son adım sönmez (pencere 1'in ötesine uzanır, ramp out 0): sahne kayarak çıkarken başlık yalnız kalmasın (Görev 11).
        // Metin sahnenin içinde, sahneyle birlikte yukarı çıkar; sonraki bölümün üstüne binmez.
        ("Takvim ve paylaşma", "Tarihi olan işler takvim daveti olarak gelir; özeti ekibinize e-postayla gönderin.", "0.86 1.2 0.08 0", "1")
    ];
}
@section Head {
    <meta name="description" content="Kaydı yükleyin; yazıya dökülsün, konuşmacılar ayrılsın, özet, kararlar ve yapılacaklar tek sayfada toplansın." />
    @* scroll-craft motorunun stili en alttaki katmanda: Tailwind'in bütün katmanları onu geçer, menü ve alt bilgi öbür sayfalarla aynı kalır. *@
    <style>@@layer scrollcraft; @@import url("/lib/scrollcraft/scrollcraft.css") layer(scrollcraft);</style>
    @* Hareket yalnız "hareketi azalt" kapalıysa ve ekran en az 500 piksel yüksekse açılır ("sc-on").
       Sınıf boyamadan önce konur ki sayfa durağan düzenden hareketli düzene sıçramasın. Motor 4 saniyede bağlanmazsa durağan düzene dönülür. *@
    <script>(function(d){if(matchMedia("(prefers-reduced-motion: no-preference)").matches&&innerHeight>=500){d.classList.add("sc-on");setTimeout(function(){if(!d.classList.contains("sc-ready"))d.classList.remove("sc-on")},4000)}})(document.documentElement)</script>
}

<section class="hh" data-home-hero data-sc-act="flow" aria-labelledby="hh-title">
    <div class="hh-photo" data-sc-parallax="1.2">
        <div class="hh-drift">
            <picture>
                <source media="(max-width: 860px)" srcset="/img/home/salon-gece-dikey-780.webp" width="780" height="1386" />
                <img src="/img/home/salon-gece-genis-1440.webp" srcset="/img/home/salon-gece-genis-1440.webp 1440w, /img/home/salon-gece-genis-1600.webp 1600w"
                     sizes="100vw" width="1600" height="900" fetchpriority="high" decoding="async"
                     alt="Akşam ışığında boş bir toplantı odası; masada kapalı bir dizüstü bilgisayar ve kahve fincanları duruyor." />
            </picture>
        </div>
    </div>
    <div class="hh-inner">
        <div class="hh-copy">
            @* Açılış metni hep görünür ("0 1 0 0"); ipucu olması yalnız doğrulama aracının kontrastı ölçmesi için. *@
            <h1 id="hh-title" class="hh-title" data-sc-cue="0 1 0 0">Toplantıyı siz yapın, notları Briefyn çıkarsın.</h1>
            <p class="hh-lede" data-sc-cue="0 1 0 0">Kaydı yükleyin; yazıya dökülsün, konuşmacılar ayrılsın, özet, kararlar ve yapılacaklar tek sayfada toplansın.</p>
            <a href="/Upload" class="btn btn-grad mt-8 h-13 px-7 text-lg font-bold focus-visible:outline-hero-title">Kayıt yükle</a>
            <p class="hh-note" data-sc-cue="0 1 0 0">Şimdilik ücretsiz.</p>
        </div>
    </div>
    <div class="hh-panel" data-sc-parallax="0.5" aria-hidden="true">
        <svg class="hh-wave" viewBox="0 0 480 220" focusable="false">
            <defs>
                @* Çubuklar panelin üst kenarından taşar: kenarın üstünde açık, panelin içinde koyu. *@
                <linearGradient id="hh-wave-ink" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="220">
                    <stop offset="0.29" stop-color="#9BEFF7" />
                    <stop offset="0.29" stop-color="#04121F" />
                </linearGradient>
            </defs>
            <g fill="none" stroke="url(#hh-wave-ink)" stroke-width="7" stroke-linecap="round">
                @for (var i = 0; i < heroBars.Length; i++)
                {
                    var x = 20 + i * 19.3;
                    var half = heroBars[i] / 2.0;
                    <path class="@(i % 2 == 1 ? "hh-bar-odd" : null)" d="M@(x.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)) @((64 - half).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))V@((64 + half).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))" />
                }
            </g>
            @* Henüz yazılmamış not satırları: dalganın gideceği yer. *@
            <g fill="none" stroke="#04121F" stroke-opacity="0.22" stroke-width="7" stroke-linecap="round">
                <path d="M20 152H380" />
                <path d="M20 176H330" />
                <path d="M20 200H200" />
            </g>
        </svg>
    </div>
</section>

<section class="hstrip" data-home-strip>
    <div class="hstrip-viewport">
        <div class="hstrip-track" data-strip-track>
            @for (var copy = 0; copy < 2; copy++)
            {
                <ul class="hstrip-list" aria-label="@(copy == 0 ? "Briefyn'e yükleyebileceğiniz toplantılar" : null)" aria-hidden="@(copy == 1 ? "true" : null)">
                    @foreach (var meeting in meetings)
                    {
                        <li class="hstrip-item">
                            <svg class="hstrip-mark" viewBox="0 0 30 24" aria-hidden="true" focusable="false"><g fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round"><path d="M3 10v4M9.5 6v12M16 3v18M22.5 7v10" /></g></svg>
                            <span>@meeting</span>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
    <button type="button" class="hstrip-toggle" data-strip-toggle aria-label="Şeridi durdur">
        <svg class="hstrip-icon-pause" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M7 4.5v11M13 4.5v11" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg>
        <svg class="hstrip-icon-play" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M7 4.8v10.4L15.2 10z" fill="currentColor" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
    </button>
</section>

@* Zirve. Temel HTML durağan bir adım listesi (betik yokken ve "hareketi azalt" açıkken bu okunur);
   home.js hareket izinliyse onu kaydırmayla ilerleyen pinli sahneye yükseltir. *@
<section class="hj" id="yolculuk" data-home-journey data-sc-act="flow" data-sc-span="5" aria-labelledby="hj-title">
    <div class="hj-stage" data-sc-stage>
        <div class="hj-grid">
            <h2 id="hj-title" class="hj-title">Bir toplantının yolculuğu</h2>
            <figure class="hj-object">
                <figcaption class="hj-label"><span class="hj-label-dot" aria-hidden="true"></span>Örnek toplantı: Haftalık ürün toplantısı</figcaption>
                <div class="hj-sheet" data-hj-scene aria-hidden="true"></div>
            </figure>
            <div class="hj-cues">
                <p class="hj-quiet" data-sc-cue="0 0.09 0 0.25">Bir toplantı bitti. Elinizde yalnız kaydı var.</p>
                <ol class="hj-steps">
                    @foreach (var step in steps)
                    {
                        <li class="hj-step">
                            <div class="hj-step-text" data-sc-cue="@step.Cue">
                                <h3 class="hj-step-name">@step.Name</h3>
                                @* "e-posta" satır sonunda tireden bölünmesin. *@
                                @{ var cut = step.Sentence.IndexOf("e-posta", StringComparison.Ordinal); }
                                <p class="hj-step-sentence">@if (cut < 0) { @step.Sentence } else { @(step.Sentence[..cut])<span class="whitespace-nowrap">e-posta</span>@(step.Sentence[(cut + 7)..]) }</p>
                            </div>
                            <div class="hj-mini" data-hj-mini="@step.End" aria-hidden="true"></div>
                        </li>
                    }
                </ol>
            </div>
        </div>
    </div>
</section>

<section class="ha" data-home-audience data-sc-act="flow" aria-labelledby="ha-title">
    <div class="ha-grid">
        <div class="ha-lead">
            <h2 id="ha-title" class="ha-title">Toplantısı çok olan her ekip için</h2>
            <picture>
                <source media="(max-width: 860px)" srcset="/img/home/masa-ustten-780.webp" width="780" height="520" />
                <img class="ha-photo" src="/img/home/masa-ustten-960.webp" width="960" height="1200" loading="lazy" decoding="async"
                     alt="Üstten bakış: toplantı masasında eller, kapalı dizüstü bilgisayarlar, kahve fincanları ve not tutulan boş bir defter." />
            </picture>
        </div>
        @* Roller katalogdan (SiteCatalog, Çözümler). "Yakında" sayfaları boş olduğu için bağlantı değiller (BRIEF 5. bölüm). *@
        <ul class="ha-roles" data-sc-in data-sc-stagger="60">
            @foreach (var solution in Model.Solutions)
            {
                <li class="ha-role">
                    <h3 class="ha-role-name">@solution.Title</h3>
                    <p class="ha-role-text">@solution.Summary</p>
                </li>
            }
        </ul>
    </div>
</section>

@* Güven: yalnız iki izinli cümle (SPEC "Ana sayfa içeriği" 5). Şeritte ses çubukları soldan sağa silinir, altındaki satırlar kalır. *@
<section class="ht" data-home-trust data-sc-act="flow" aria-labelledby="ht-title">
    <div class="ht-inner">
        <div class="ht-band" aria-hidden="true">
            <svg class="ht-bars" viewBox="0 0 960 112" preserveAspectRatio="none" focusable="false">
                <g fill="none" stroke="#0697B4" stroke-width="7" stroke-linecap="round">
                    @for (var i = 0; i < 48; i++)
                    {
                        var x = 8 + i * (944 / 47.0);
                        var half = heroBars[i % heroBars.Length] * 0.46;
                        <path class="@(i % 2 == 1 ? "ht-bar-odd" : null)" d="M@(x.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)) @((56 - half).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))V@((56 + half).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))" vector-effect="non-scaling-stroke" />
                    }
                </g>
            </svg>
            <div class="ht-lines" data-sc-reveal="left" data-sc-reveal-at="0.25 0.6">
                <span class="ht-line ht-line-1"></span>
                <span class="ht-line ht-line-2"></span>
                <span class="ht-line-end"><span class="ht-line ht-line-3"></span><span class="ht-lock">@await Html.PartialAsync("_Icons", "lock")</span></span>
            </div>
        </div>
        <h2 id="ht-title" class="ht-title">Verileriniz ne oluyor?</h2>
        <p class="ht-claim">Toplantılarınız yapay zekâ eğitiminde kullanılmaz.</p>
        <p class="ht-claim">Ses analizden sonra silinir, döküm şifreli saklanır.</p>
        <a href="/Privacy" class="ht-link">Gizlilik</a>
    </div>
</section>

@* Sık sorulanlar: cevaplar koddan ve ayardan (BRIEF 9. bölüm, satır 20-24). Açılıp kapanma tarayıcının kendi <details> davranışı. *@
<section class="hf" data-home-faq aria-labelledby="hf-title">
    <div class="hf-inner">
        <h2 id="hf-title" class="hf-title">Sık sorulanlar</h2>
        <div class="hf-list" data-sc-in data-sc-stagger="50">
            <details class="hf-item">
                <summary class="hf-q">Briefyn ücretli mi?@await Html.PartialAsync("_Icons", "chevron-down")</summary>
                <div class="hf-a"><p>Şimdilik her şey ücretsiz.</p></div>
            </details>
            <details class="hf-item">
                <summary class="hf-q">Hangi dosyaları yükleyebilirim?@await Html.PartialAsync("_Icons", "chevron-down")</summary>
                <div class="hf-a"><p>@Model.FileTypes; bir dosya en fazla @Model.MaxMegabytes MB.</p></div>
            </details>
            <details class="hf-item">
                <summary class="hf-q">Zoom kayıtlarımı alabilir miyim?@await Html.PartialAsync("_Icons", "chevron-down")</summary>
                <div class="hf-a"><p>Evet. Zoom hesabınızı bağlayın, bulut kayıtlarınızı listeden seçip tek tıkla aktarın.</p></div>
            </details>
            <details class="hf-item">
                <summary class="hf-q">Verilerim ne oluyor?@await Html.PartialAsync("_Icons", "chevron-down")</summary>
                <div class="hf-a"><p>Toplantılarınız yapay zekâ eğitiminde kullanılmaz.</p><p>Ses analizden sonra silinir, döküm şifreli saklanır.</p></div>
            </details>
            <details class="hf-item">
                <summary class="hf-q">Hesap açmam gerekiyor mu?@await Html.PartialAsync("_Icons", "chevron-down")</summary>
                <div class="hf-a"><p>Evet, ücretsiz bir hesap açarsınız; kayıttan sonra doğrudan yükleme ekranına dönersiniz.</p></div>
            </details>
        </div>
    </div>
</section>

@* Kapanış: aynı çizgiler son kez toplanıp Briefyn işaretinde durur; çağrı işaretin not satırının yanında. Son bölüm: ipucu tek değerli ve tutulur. *@
<section class="hc" data-home-closing data-sc-act="flow" data-sc-span="1.3" aria-labelledby="hc-title">
    <div class="hc-stage" data-sc-stage>
        <div class="hc-grid">
            @* İşaret, logo A'nın yolları (docs/brand/logo-a.svg): dört ses çubuğu, sonuncusu iki not satırına dönüşür, altta kısa üçüncü satır. *@
            <svg class="hc-mark" viewBox="0 2 90 49" aria-hidden="true" focusable="false" data-hc-mark>
                <defs>
                    <linearGradient id="hc-mark-ink" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="90" y2="0">
                        <stop offset="0" stop-color="#00D3E6" />
                        <stop offset="1" stop-color="#1E9BFF" />
                    </linearGradient>
                </defs>
                <g fill="none" stroke="url(#hc-mark-ink)" stroke-width="6.5" stroke-linecap="round" stroke-linejoin="round">
                    <path pathLength="1" style="--d: -1" d="M3.5 23V31" />
                    <path pathLength="1" style="--d: -1" d="M13.75 16V38" />
                    <path pathLength="1" style="--d: -1" d="M24 7V45" />
                    <path pathLength="1" style="--d: 0.05" d="M34.25 16V33Q34.25 37 38.25 37C44 37 46 27 52 27H86" />
                    <path pathLength="1" style="--d: 0.25" d="M34.25 26H38.25C44 26 46 16 52 16H86" />
                    <path pathLength="1" style="--d: 0.45" d="M58 38H74" />
                </g>
            </svg>
            <div class="hc-copy" data-sc-cue="0.12">
                <h2 id="hc-title" class="hc-title">Sıradaki toplantının notlarını Briefyn çıkarsın.</h2>
                <a href="/Upload" class="btn btn-grad mt-7 h-13 px-7 text-lg font-bold focus-visible:outline-hero-title" data-hc-cta>Kayıt yükle</a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="/lib/scrollcraft/scrollcraft.js" defer></script>
    <script src="~/js/home.js" asp-append-version="true" defer></script>
}
