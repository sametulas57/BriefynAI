# Copy to .env and fill in. Never commit .env.

# Web address: empty = only this computer. Set 0.0.0.0 only to test from a real phone on your home network.
WEB_BIND=

# Database
# PostgreSQL superuser postgres: only db-init and db-readonly connect with this password.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
MIGRATOR_DB_PASSWORD=
READONLY_DB_PASSWORD=

# Encryption: 32 random bytes, base64 (openssl rand -base64 32)
ENCRYPTION_KEY_V2=

# AI (Groq ve Azure Speech)
# Azure Speech: yüklenen dosyalar konuşmacı ayrılarak yazıya dökülür. Azure anahtarı yoksa TRANSCRIBER=groq yazın (konuşmacı ayrılmaz). Anahtar ve uç nokta Azure portalında Speech kaynağının "Keys and Endpoint" sayfasında
TRANSCRIBER=azure
AZURE_SPEECH_KEY=
AZURE_SPEECH_ENDPOINT=
GROQ_KEY=
AI_ANSWER_MODEL=
ANSWERER=

# Email
EMAIL_SENDER=
EMAIL_PASSWORD=

# Background job dashboard (/hangfire): only this user can open it
HANGFIRE_ADMIN_EMAIL=

# Zoom integration (optional)
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET=
ZOOM_REDIRECT_URI=
