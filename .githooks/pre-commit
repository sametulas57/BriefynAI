#!/bin/sh
# Her commit'ten önce scripts/dogrula.sh (build + testler). Kalırsa commit durur.
# Claude da Codex de aynı hook'tan geçer. Yalnız doküman (docs/, *.md) değiştiyse atlanır.
KOD=$(git diff --cached --name-only | grep -vE '^docs/|\.md$' || true)
[ -z "$KOD" ] && exit 0
# Testler çalışma klasöründe koşar; commit'e girmeyen kod değişikliği (izlenmeyen yeni dosya dahil) varsa sonuç commit'i temsil etmez.
EKSIK=$( { git diff --name-only; git ls-files --others --exclude-standard; } | grep -vE '^docs/|\.md$' || true)
if [ -n "$EKSIK" ]; then
  echo "Doğrulama: KALDI (commit'e hazırlanmamış kod değişikliği var: $(echo "$EKSIK" | head -3 | tr '\n' ' '))"
  echo "  Hepsini ekle (git add) ya da ayır (git stash -u --keep-index), sonra tekrar commit et."
  exit 1
fi
exec "$(git rev-parse --show-toplevel)/scripts/dogrula.sh"
